# PostgreSQL connection string for the `reflect` database.
DATABASE_URL=postgresql://localhost:5432/reflect

# Login tokens are digitally signed with an RSA key pair (RS256). Create it once with:
#   mkdir -p keys && openssl genrsa -out keys/jwt_private.pem 2048 && openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
# The keys are written to backend/keys/ (git ignores that folder). Never commit the private key.
# Only set these two if you keep the keys somewhere else:
# JWT_PRIVATE_KEY_PATH=/path/to/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/jwt_public.pem

# Fallback ONLY when no key pair exists: a long random secret (HS256, a shared-secret signature).
JWT_SECRET=replace-with-a-long-random-value

# Comma-separated list of allowed CORS origins for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Chatbot provider: "ollama" (default, local/offline) or "huggingface" (hosted).
CHATBOT_PROVIDER=ollama

# Used when CHATBOT_PROVIDER=ollama. Install Ollama and `ollama pull qwen3:4b`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Used when CHATBOT_PROVIDER=huggingface. Requires an HF token and explicit
# opt-in to send records to a hosted model provider.
CHATBOT_ALLOW_EXTERNAL_PHI=false
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507:fastest
